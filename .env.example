# Vorlage – als .env kopieren und ausfüllen. Die .env-Datei wird NICHT committet.

# Admin-Passwort als scrypt-Hash. Erzeugen mit:  npm run admin:hash
ADMIN_PASSWORD_HASH=

# Nur für die lokale Entwicklung: Klartext-Passwort statt Hash (in Produktion nicht verwenden)
# ADMIN_PASSWORD=

# Ordner für die Datendatei db.json (Standard: server/data)
# DATA_DIR=/var/lib/biohof-tambke

# Port des Produktionsservers (npm start)
# PORT=3000

# Hinter einem Reverse-Proxy (nginx, Caddy, Render …) die Client-IP aus X-Forwarded-For lesen
# TRUST_PROXY=1
